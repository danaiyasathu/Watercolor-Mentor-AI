{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User progress and preferences in the watercolor course",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Authentication UID"
        },
        "currentLessonId": {
          "type": "number",
          "description": "ID of current watercolor lesson"
        },
        "completedLessons": {
          "type": "array",
          "description": "List of completed lesson IDs"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp of last update"
        }
      },
      "required": ["uid", "currentLessonId", "completedLessons", "updatedAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Artwork submission and AI mentor evaluation for a lesson",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique submission identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID"
        },
        "lessonId": {
          "type": "number",
          "description": "Lesson number"
        },
        "imageUrl": {
          "type": "string",
          "description": "Primary artwork image URL or storage reference"
        },
        "userNotes": {
          "type": "string",
          "description": "User reflection notes"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "userId", "lessonId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user learning progress"
    },
    "/users/{userId}/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Stores artwork submissions and evaluations for the user"
    }
  }
}
